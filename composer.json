{
  "name": "xihanfun/xihan-framework",
  "description": "XiHan Framework SDK for PHP: primitives, manifest, invocation context, pipeline and operations.",
  "type": "library",
  "license": "MIT",
  "keywords": ["xihan", "framework", "plugin", "pipeline", "manifest"],
  "homepage": "https://framework.xihanfun.com",
  "support": {
    "issues": "https://github.com/XiHanFun/framework-sdk-php/issues",
    "source": "https://github.com/XiHanFun/framework-sdk-php",
    "docs": "https://framework.docs.xihanfun.com"
  },
  "authors": [
    { "name": "XiHanFun", "homepage": "https://github.com/XiHanFun" }
  ],
  "require": {
    "php": ">=8.3",
    "ext-json": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "XiHan\\Framework\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "XiHan\\Framework\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "test": "phpunit",
    "check": ["@lint", "@analyse", "@test"]
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  }
}
