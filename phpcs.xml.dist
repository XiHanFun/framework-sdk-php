<?xml version="1.0"?>
<!-- 格式检查：PSR-12，范围是源码、测试、示例与脚本；protoc 生成的协议类不检查 -->
<ruleset name="XiHan Framework SDK for PHP">
  <description>PSR-12 coding style for the XiHan Framework SDK for PHP.</description>

  <file>src</file>
  <file>tests</file>
  <file>examples</file>
  <file>scripts</file>

  <exclude-pattern>src/Plugin/Protocol/*</exclude-pattern>

  <arg name="extensions" value="php"/>
  <arg name="encoding" value="utf-8"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <rule ref="PSR12"/>

  <!-- 测试里的 JSON 夹具按原样写在一行，便于与规范的一致性向量逐条对照；源码仍按 120 列 -->
  <rule ref="Generic.Files.LineLength">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
</ruleset>
